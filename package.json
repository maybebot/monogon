{
  "name": "monogon",
  "version": "0.3.4",
  "description": "Modern syntax highlighting for developer tooling",
  "author": "Ian Bobinac",
  "license": "MIT",
  "keywords": [
    "monogon",
    "syntax",
    "highlighting",
    "editor",
    "code",
    "snippet",
    "block",
    "developer",
    "tooling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/monogon"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "oxlint": "^1.26.0",
    "oxlint-tsgolint": "^0.5.1",
    "prettier": "3.3.3",
    "release-it": "^19.0.2",
    "tsdown": "^0.15.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "unplugin-vue": "^7.0.2",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.2.3",
    "vue-tsc": "^3.1.1"
  },
  "peerDependencies": {
    "vue": "^3.0.0 || ^2.0.0",
    "preact": "^10.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/monogon-code.js",
  "module": "./dist/monogon-code.js",
  "exports": {
    ".": {
      "import": "./dist/monogon-code.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue/MonogonCode.d.ts",
      "import": "./dist/frameworks/vue/MonogonCode.js"
    },
    "./react": {
      "types": "./dist/frameworks/react/MonogonCode.d.ts",
      "import": "./dist/frameworks/react/MonogonCode.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact/MonogonCode.d.ts",
      "import": "./dist/frameworks/preact/MonogonCode.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid/MonogonCode.d.ts",
      "import": "./dist/frameworks/solid/MonogonCode.js"
    }
  }
}
