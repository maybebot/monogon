{
  "name": "monogon",
  "version": "0.3.6",
  "description": "Modern syntax highlighting for developer tooling",
  "keywords": [
    "block",
    "code",
    "developer",
    "editor",
    "highlighting",
    "monogon",
    "snippet",
    "syntax",
    "tooling"
  ],
  "license": "MIT",
  "author": "Ian Bobinac",
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/monogon"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/monogon-code.js",
  "module": "./dist/monogon-code.js",
  "exports": {
    ".": {
      "import": "./dist/monogon-code.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue/MonogonCode.d.ts",
      "import": "./dist/frameworks/vue/MonogonCode.js"
    },
    "./react": {
      "types": "./dist/frameworks/react/MonogonCode.d.ts",
      "import": "./dist/frameworks/react/MonogonCode.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact/MonogonCode.d.ts",
      "import": "./dist/frameworks/preact/MonogonCode.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid/MonogonCode.d.ts",
      "import": "./dist/frameworks/solid/MonogonCode.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "test": "vitest",
    "lint": "oxlint --type-aware",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.1"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "solid-js": "^1.0.0",
    "vue": "^3.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.2.2"
}
