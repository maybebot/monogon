{
  "name": "monogon",
  "version": "0.1.4",
  "description": "Modern syntax highlighting for developer tooling",
  "author": "Ian Bobinac",
  "license": "MIT",
  "keywords": [
    "monogon",
    "syntax",
    "highlighting",
    "editor",
    "code",
    "snippet",
    "block",
    "developer",
    "tooling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/monogon"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "prettier": "3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.2.3"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/monogon-code.js",
  "module": "./dist/monogon-code.js",
  "exports": {
    ".": {
      "import": "./dist/monogon-code.js"
    },
    "./vue": {
      "import": "./dist/frameworks/vue/MonogonCode.js"
    },
    "./react": {
      "import": "./dist/frameworks/preact/MonogonCode.jsx"
    },
    "./preact": {
      "import": "./dist/frameworks/preact/MonogonCode.jsx"
    },
    "./solid": {
      "import": "./dist/frameworks/solid/MonogonCode.jsx"
    }
  }
}
