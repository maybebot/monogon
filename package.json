{
  "name": "monogon",
  "version": "0.3.4",
  "description": "Modern syntax highlighting for developer tooling",
  "keywords": [
    "block",
    "code",
    "developer",
    "editor",
    "highlighting",
    "monogon",
    "snippet",
    "syntax",
    "tooling"
  ],
  "license": "MIT",
  "author": "Ian Bobinac",
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/monogon"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/monogon-code.js",
  "module": "./dist/monogon-code.js",
  "exports": {
    ".": {
      "import": "./dist/monogon-code.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue/MonogonCode.d.ts",
      "import": "./dist/frameworks/vue/MonogonCode.js"
    },
    "./react": {
      "types": "./dist/frameworks/react/MonogonCode.d.ts",
      "import": "./dist/frameworks/react/MonogonCode.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact/MonogonCode.d.ts",
      "import": "./dist/frameworks/preact/MonogonCode.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid/MonogonCode.d.ts",
      "import": "./dist/frameworks/solid/MonogonCode.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "release-it": "^20.0.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "solid": "^1.0.0",
    "vue": "^3.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
